{
  "manifest_version": 3,
  "name": "Gatekeeper",
  "version": "0.1.1",
  "description": "A daily budget for each kind of site that pulls you away. Loosening a rule waits until the next morning.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "idle",
    "alarms"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.tiktok.com/*",
    "*://*.facebook.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.reddit.com/*",
    "*://*.snapchat.com/*",
    "*://*.threads.net/*",
    "*://*.bsky.app/*",
    "*://*.pinterest.com/*",
    "*://*.tumblr.com/*",
    "*://*.linkedin.com/*",
    "*://*.vk.com/*",
    "*://*.weibo.com/*",
    "*://*.youtube.com/*",
    "*://*.youtu.be/*",
    "*://*.youtube-nocookie.com/*",
    "*://*.netflix.com/*",
    "*://*.twitch.tv/*",
    "*://*.primevideo.com/*",
    "*://*.disneyplus.com/*",
    "*://*.hulu.com/*",
    "*://*.max.com/*",
    "*://*.vimeo.com/*",
    "*://*.dailymotion.com/*",
    "*://*.crunchyroll.com/*",
    "*://*.bilibili.com/*",
    "*://*.kick.com/*",
    "*://*.openfront.io/*",
    "*://*.agar.io/*",
    "*://*.slither.io/*",
    "*://*.diep.io/*",
    "*://*.krunker.io/*",
    "*://*.chess.com/*",
    "*://*.lichess.org/*",
    "*://*.poki.com/*",
    "*://*.crazygames.com/*",
    "*://*.miniclip.com/*",
    "*://*.coolmathgames.com/*",
    "*://*.geoguessr.com/*",
    "*://*.roblox.com/*",
    "*://*.itch.io/*",
    "*://*.armorgames.com/*",
    "*://*.kongregate.com/*",
    "*://*.addictinggames.com/*",
    "*://*.neal.fun/*",
    "*://*.wordle.global/*",
    "*://*.skribbl.io/*",
    "*://*.cnn.com/*",
    "*://*.nytimes.com/*",
    "*://*.bbc.com/*",
    "*://*.bbc.co.uk/*",
    "*://*.theguardian.com/*",
    "*://*.foxnews.com/*",
    "*://*.washingtonpost.com/*",
    "*://*.wsj.com/*",
    "*://*.ft.com/*",
    "*://*.bloomberg.com/*",
    "*://*.reuters.com/*",
    "*://*.apnews.com/*",
    "*://*.nbcnews.com/*",
    "*://*.politico.com/*",
    "*://*.news.ycombinator.com/*",
    "*://*.news.google.com/*",
    "*://*.lemonde.fr/*",
    "*://*.spiegel.de/*",
    "*://*.huffpost.com/*",
    "*://*.axios.com/*",
    "*://*.amazon.com/*",
    "*://*.ebay.com/*",
    "*://*.etsy.com/*",
    "*://*.aliexpress.com/*",
    "*://*.temu.com/*",
    "*://*.shein.com/*",
    "*://*.walmart.com/*",
    "*://*.target.com/*",
    "*://*.bestbuy.com/*",
    "*://*.zara.com/*",
    "*://*.asos.com/*",
    "*://*.hm.com/*",
    "*://*.uniqlo.com/*",
    "*://*.wayfair.com/*",
    "*://*.zalando.com/*",
    "https://gatekeeper-relay.mvallot22.workers.dev/*"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "hands/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Gatekeeper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "pages/popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pages/gate.html"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
