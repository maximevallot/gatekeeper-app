{
  "manifest_version": 3,
  "name": "Gatekeeper",
  "version": "0.1.0",
  "description": "A daily budget for each kind of site that pulls you away. Loosening a rule waits until the next morning.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "declarativeNetRequest", "idle", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "hands/background.js", "type": "module" },
  "action": { "default_title": "Gatekeeper" },
  "web_accessible_resources": [
    { "resources": ["pages/gate.html", "pages/gate.js", "pages/common.js", "pages/style.css"], "matches": ["<all_urls>"] }
  ]
}
